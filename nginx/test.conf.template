# 测试环境 host nginx 站点模板。
# CI 部署时用 sed 替换占位符后落地到 /etc/nginx/sites-available/<domain>：
#   __DOMAIN__    -> 域名（autotest.chenmoyuan.tech）
#   __APP_PORT__  -> app 容器映射到 host 的端口（默认 18084）
# 证书由 certbot --nginx 首次签发；本模板仅在证书就绪后落地。

upstream auto_test_app {
    server 127.0.0.1:__APP_PORT__;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    charset utf-8;
    client_max_body_size 60m;

    location / {
        proxy_pass http://auto_test_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # 用例执行可能耗时较长（视觉模型推理），放宽读超时并关闭缓冲以便进度即时可见
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}
