# 测试环境配置模板。
# CI 首次部署会自动 cp 为 deploy/test.env；之后不会覆盖，改配置直接在目标机上编辑
# /opt/auto_test/deploy/test.env 再重启容器（或重跑一次部署）。

# app 容器映射到宿主机的端口（仅绑定 127.0.0.1，由 host nginx 反代）
AT_APP_PORT=18084

# Midscene 视觉模型配置（留空时 Web UI runner 标记为不可用，其余功能正常）
# 用至少 32 个随机字符生成，仅保留在服务器 deploy/test.env 中；用于加密平台中保存的模型 API Key。
PLATFORM_CONFIG_ENCRYPTION_KEY=
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# CMS API runner 配置（留空时 API runner 标记为不可用）
CMS_BASE_URL=
CMS_AES_KEY=
CMS_AES_IV=
CMS_APP_KEY=
CMS_USERNAME=
CMS_PASSWORD=
CMS_GOOGLE_SECRET=
CMS_OAUTH_ID=
CMS_OAUTH_TYPE=
CMS_VERSION=
CMS_BUNDLE_ID=
CMS_LANGUAGE=
CMS_VIA=
