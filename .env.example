# Copy this file to .env and provide your vision model service configuration.
MIDSCENE_MODEL_BASE_URL=https://your-model-service.example/v1
MIDSCENE_MODEL_API_KEY=replace-with-your-key
MIDSCENE_MODEL_NAME=replace-with-your-model-name
MIDSCENE_MODEL_FAMILY=replace-with-your-model-family
MIDSCENE_REPLANNING_CYCLE_LIMIT=40

# Execution timeout protection (milliseconds).
# Web UI steps: 120 seconds; API steps: 30 seconds; one case: 10 minutes.
NOVATEST_WEB_STEP_TIMEOUT_MS=120000
NOVATEST_API_STEP_TIMEOUT_MS=30000
NOVATEST_CASE_TIMEOUT_MS=600000
